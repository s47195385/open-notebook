# Open Notebook Configuration for Ollama
# Pre-configured template for using Ollama (local AI models)
# Copy this to docker.env or .env to get started quickly

# API Configuration
# This tells the frontend where to find the API
API_URL=http://localhost:5055

# OLLAMA CONFIGURATION
# Choose the option that matches your setup:

# Option 1: Ollama running on the same machine (most common)
# OLLAMA_API_BASE="http://localhost:11434"

# Option 2: Open Notebook in Docker, Ollama on host machine
# IMPORTANT: Start Ollama with: export OLLAMA_HOST=0.0.0.0:11434 && ollama serve
OLLAMA_API_BASE="http://host.docker.internal:11434"

# Option 3: Ollama in same Docker Compose stack
# OLLAMA_API_BASE="http://ollama:11434"

# Option 4: Ollama on a remote machine
# OLLAMA_API_BASE="http://192.168.1.100:11434"

# SURREALDB CONFIGURATION
# For single-container deployment (v1-latest-single image)
SURREAL_URL="ws://localhost:8000/rpc"
SURREAL_USER="root"
SURREAL_PASSWORD="root"
SURREAL_NAMESPACE="open_notebook"
SURREAL_DATABASE="production"

# OPTIONAL: Timeout settings for local models
# Increase these if using CPU-based inference or slow hardware
# API_CLIENT_TIMEOUT=600           # 10 minutes for API responses
# ESPERANTO_LLM_TIMEOUT=300        # 5 minutes for model inference

# OPTIONAL: Cloud AI providers (if you want to use them alongside Ollama)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# RECOMMENDED OLLAMA MODELS:
# Language models (choose one or more):
#   ollama pull qwen3              # Best general purpose
#   ollama pull deepseek-r1        # Best for reasoning tasks
#   ollama pull gemma3             # Good balanced performance
#   ollama pull phi4               # Fast, works on limited hardware
#
# Embedding model (required for search):
#   ollama pull mxbai-embed-large  # Best embedding model
#
# After pulling models, configure them in Open Notebook:
# 1. Access the UI at http://localhost:8502
# 2. Go to Settings > AI Models
# 3. Add your Ollama models
# 4. Set them as default for various tasks
